{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host unit tests (macOS / Linux / CI)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FX_BUILD_TESTS": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "host-min",
      "displayName": "Host unit tests, min profile (all optional features off)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host-min",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FX_BUILD_TESTS": "ON",
        "FX_PROFILE": "min"
      }
    },
    {
      "name": "host-software",
      "displayName": "CPU reference backend self-test (runs on any OS)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/host-software",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FX_BUILD_TESTS": "ON",
        "FX_BUILD_WIN_APP": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "mac",
      "displayName": "macOS AppKit Metal demo (this Mac)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/mac",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "FX_BUILD_TESTS": "OFF",
        "FX_BUILD_MAC_APP": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "ios-sim",
      "displayName": "iOS Simulator Xcode project",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-sim",
      "environment": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "FX_BUILD_TESTS": "OFF",
        "FX_BUILD_IOS_APP": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "ios-device",
      "displayName": "iPhone device Xcode project",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-device",
      "environment": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "FX_BUILD_TESTS": "OFF",
        "FX_BUILD_IOS_APP": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows Win32 demo (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "FX_BUILD_TESTS": "ON",
        "FX_BUILD_WIN_APP": "ON",
        "FX_PROFILE": "lite"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64 NDK library (needs ANDROID_NDK_HOME)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "CMAKE_BUILD_TYPE": "Release",
        "FX_BUILD_TESTS": "OFF",
        "FX_BUILD_ANDROID_APP": "ON",
        "FX_PROFILE": "lite"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "host-min", "configurePreset": "host-min" },
    { "name": "host-software", "configurePreset": "host-software" },
    { "name": "mac", "configurePreset": "mac" },
    { "name": "ios-sim", "configurePreset": "ios-sim",
      "environment": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" } },
    { "name": "ios-device", "configurePreset": "ios-device",
      "environment": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" } },
    { "name": "windows-x64", "configurePreset": "windows-x64" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
