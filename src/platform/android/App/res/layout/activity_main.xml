<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.texiao.demo.FXRenderView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="10dp"
        android:background="#99000000"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:text="引擎初始化中…"
        android:textColor="#B8FFF0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="110dp"
        android:layout_marginStart="10dp"
        android:background="#EDEF8C2B"
        android:padding="8dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0B1118"
        android:orientation="vertical"
        android:padding="10dp">

        <Spinner
            android:id="@+id/assetSpinner"
            android:layout_width="match_parent"
            android:layout_height="38dp" />

        <TextView
            android:id="@+id/paramLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DCE6F5"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/paramSeek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:max="1000" />

        <SeekBar
            android:id="@+id/brightnessSeek"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:max="100"
            android:progress="50" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/patternButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="测试图"
                android:textSize="10sp" />

            <Button
                android:id="@+id/cameraButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="摄像头"
                android:textSize="10sp" />

            <Button
                android:id="@+id/imageButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="图片"
                android:textSize="10sp" />

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="暂停"
                android:textSize="10sp" />

            <Button
                android:id="@+id/readbackButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="回读"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
